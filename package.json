{
  "name": "midnight-ptr-tracker",
  "version": "1.0.0",
  "description": "WoW Midnight 12.1 PTR spec tracker — multi-source tier data compiled into a single self-contained HTML artifact",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "node src/apply-community-overrides.mjs",
    "build": "node src/build.mjs",
    "check": "npm test && npm run build",
    "gearing:build": "node gearing/src/build.mjs",
    "gearing:test": "node --test \"gearing/test/*.test.mjs\"",
    "test": "node --test",
    "prevalidate": "node src/apply-community-overrides.mjs",
    "validate": "node src/validate.mjs",
    "audit:creators": "node src/audit-creators.mjs",
    "report-card": "node src/report-card.mjs",
    "serve": "node src/serve.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
