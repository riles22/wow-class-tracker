  "_schemaVersion": 2,
  "_provenance": "Compiled from Blizzard's official class pages and official Midnight patch notes. Class pages establish class-wide proficiencies and preferred weapons; specLoadouts adds the hand, core-ability, and patch restrictions needed for item eligibility. See officialSources and each spec's sourceUrls.",
  "_types": "itemTypes and inventorySlots match the type and slot fields produced by src/lib-wowhead.mjs. Held In Off-hand items currently have type null, so those loadout slots explicitly use itemTypes: [null].",
  "_loadoutSchema": {
    "selection": "For a selected patch context, choose exactly one loadout for the spec. Loadouts within a spec are mutually exclusive complete weapon configurations.",
    "patchContexts": "A spec-level patchContexts array applies to all its loadouts unless a loadout supplies its own patchContexts array.",
    "hands": "mainHand and offHand are exact equipment positions. required means the position must be filled; mustBeEmpty means no item can be equipped there. occupiesBothHands is explicit because the harvested Ranged slot can mean either a two-handed Hunter weapon or a one-handed wand.",
    "matching": "An item matches a hand only when both its slot is in inventorySlots and its type is in itemTypes. Main-hand candidates accept One-Hand or Main Hand; off-hand weapons accept One-Hand or Off Hand.",
    "primaryStat": "Filter equippable weapons to the spec's primary stat after loadout matching. Honor primaryStatExceptions for explicitly gated non-weapon offhands. Items whose primary stat is absent still require an explicit consumer policy; do not treat absence as an automatic match."
  },
  "primaryStatExceptions": {
    "itemTypes": [],
    "inventorySlots": ["Held In Off-hand"],
    "reason": "Held-in-off-hand items are already constrained to valid Intellect specs by exact loadouts and currently have type null. Shields retain both Strength and Intellect through tooltip parsing and are not exempt."
  },
