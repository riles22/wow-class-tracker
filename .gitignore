node_modules/
*.log
.DS_Store
Thumbs.db

# WCL API credentials
.claude/skills/refresh-metrics/config.json

# deterministic WCL fetch output (src/fetch-wcl.mjs) — travels between nightly jobs
# as an artifact, never committed
wcl-fetch/

# machine-local skills mirror (may contain the gitignored WCL config) — never commit
.agents/
AGENTS.md

# deterministic pre-agent transcript stage output (consumed in-run, never committed)
transcript-fetch/

# resumable local SimulationCraft runs; accepted evidence is promoted to gearing/data/simc-audit/
gearing/.simc-work/
# withPromotionLock creates <path>.promotion.lock beside EVERY target it locks — the run
# manifest as well as the weights file (run-simc-reference.mjs) — and a hard crash can
# leave either behind; ignore the pattern, not one instance.
gearing/data/*.promotion.lock
