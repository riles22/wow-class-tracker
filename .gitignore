node_modules/
**/AGENTS.md
!/AGENTS.md
*.log
.DS_Store
Thumbs.db

# WCL API credentials
.claude/skills/refresh-metrics/config.json

# deterministic WCL fetch output (src/fetch-wcl.mjs) — travels between nightly jobs
# as an artifact, never committed
wcl-fetch/

# Track only generated skill entry points; local credentials, logs, and scratch stay private.
.agents/*
!.agents/skills/
.agents/skills/*
!.agents/skills/*/
.agents/skills/*/*
!.agents/skills/*/SKILL.md

# deterministic pre-agent transcript stage output (consumed in-run, never committed)
transcript-fetch/

# deterministic pre-agent page-self-date evidence (src/fetch-published.mjs) — travels
# between nightly jobs as an artifact, never committed. Ignored for the same local-run
# hygiene reason as wcl-fetch/: an untracked leftover trips the scheduled local run's
# clean-tree precheck, and a stale one reds the --manifest freshness guard.
published-evidence/

# Deterministic public-source availability receipts; diagnostics, never game data.
source-health/

# Deterministic metrics and official-note receipts travel as trusted run artifacts.
metrics-fetch/
official-notes/

# The SimC pipeline was retired 2026-08-18 (gearing-s2-scope Phase A), but its local run
# scratch and crash-leftover lock files may still exist on machines that ran it — keep
# ignoring both so they can never be staged by accident.
gearing/.simc-work/
gearing/data/*.promotion.lock
